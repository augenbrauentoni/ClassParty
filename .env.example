# ===================================================================
# CLASS PARTY SPIEL - OPTIONALE UMGEBUNGSVARIABLEN
# ===================================================================

# Standard-Port fuer den lokalen Server (Standard: 3000)
PORT=3000

# Falls du einen eigenen kostenlosen Ngrok-Account besitzt (https://dashboard.ngrok.com/signup):
# Trage hier deinen Authtoken ein. Dann nutzt das Spiel Ngrok als primaeren Tunnel.
# (Falls leer, startet das Spiel vollautomatisch und kostenlos ueber Localtunnel!)
# NGROK_AUTHTOKEN=dein_ngrok_authtoken_hier

# Falls du das Spiel auf einem Cloud-Server hostest (z. B. Render, Railway, VPS):
# Trage hier die oeffentliche HTTPS-Domain ein (z. B. https://class-party.onrender.com)
# PUBLIC_URL=https://deine-domain.com

# 1 = Tunnel immer erzwingen, 0 = Lokaler Offline-Modus
# TUNNEL=1
